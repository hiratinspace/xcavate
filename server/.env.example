PORT=8787
LLM_PROVIDER=mock            # mock | anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5  # best precision and latency in the V-03 eval (vs Haiku 5.5 and Opus 5.5)
LLM_TIMEOUT_MS=20000          # model deadline; must stay below the extension's 25 s analyze timeout
DB_PATH=./data/xcavate.db
RATE_LIMIT_PER_MIN=30
# STORE=                     # optional: sqlite | memory (default: sqlite when node:sqlite is available)
# PUBLISH_CLIENT_REPORTS=false  # true lets client POSTs fill GET /v1/report (only for a trusted single-user setup)
